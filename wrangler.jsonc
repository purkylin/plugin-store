{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hawk-plugin-store",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hawk-plugin-store",
      "migrations_dir": "migrations"
    }
  ]
}
